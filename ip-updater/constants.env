# Shared constants for KaMS Club Bot IP updater (used by Python and Bash)
# Keep simple KEY=VALUE pairs without quotes for compatibility.

# Application name
BOT_APP_NAME=KaMS-Club-Bot

# Core paths (HOME and other env vars will be expanded by the consumer, e.g., by systemd or bash)
BOT_CONFIG_DIR=$HOME/.config/$BOT_APP_NAME
REPO_CONFIG_FILE=$BOT_CONFIG_DIR/github_repo
GITHUB_TOKEN_FILE=$BOT_CONFIG_DIR/github_token
IP_CACHE_FILE=$BOT_CONFIG_DIR/ip_cache.json
LOG_FILE=$HOME/$BOT_APP_NAME/ip_updater.log

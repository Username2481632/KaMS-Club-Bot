[Unit]
Description=KaMS Club Bot
# Waiting for the internet before each start keeps a slow network from costing a restart.
Requires=kams-bot-internet.service
After=kams-bot-internet.service network.target
# Restarts are for the occasional unforeseen failure. A bot that needs more than three
# starts within an hour is broken in a way more retries would only make worse, so it is left
# stopped, which the down alert reports.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
User=%i
WorkingDirectory=/home/%i/KaMS-Club-Bot
ExecStart=/home/%i/KaMS-Club-Bot/venv/bin/python3.12 /home/%i/KaMS-Club-Bot/src/bot.py
Restart=on-failure
RestartSec=60
StandardOutput=append:/home/%i/KaMS-Club-Bot/bot.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
